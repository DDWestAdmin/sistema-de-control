<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/fondo_sistema_control">

    <EditText
        android:id="@+id/etsmartlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMARTLOCK ADMINISTRADOR"
        android:textColor="@color/white"
        android:fontFamily="@font/orbitron_black"
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etcorreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingrese su Correo Electrónico"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:fontFamily="@font/orbitron_black"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="18dp"/>

    <EditText
        android:id="@+id/etcontrasenna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:hint="Ingrese su Contraseña"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:fontFamily="@font/orbitron_black"
        android:inputType="textPassword"/>

    <Button
        android:id="@+id/etbutton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/orbitron_black"
        android:text="Ingresar"
        android:layout_marginBottom="28dp"/>

    <Button
        android:id="@+id/etborrador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/orbitron_black"
        android:text="Vacíar Campos"
        android:layout_marginBottom="28dp"/>

    <Button
        android:id="@+id/etinicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/orbitron_black"
        android:text="Volver a Inicio"/>
</LinearLayout>
