<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/fondo_sistema_control">

    <TextView
        android:id="@+id/etpanelhistorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:text="HISTORIAL DE REGISTRO"
        android:fontFamily="@font/orbitron_black"
        android:textColor="@color/white"
        android:textSize="26dp"
        android:textStyle="bold"
        android:layout_marginBottom="18dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/ethistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12dp"
            android:textColor="@color/white"
            android:fontFamily="@font/orbitron_black"
            android:lineSpacingExtra="8dp"/>
    </ScrollView>

    <Button
        android:id="@+id/etvolvertarjetas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/orbitron_black"
        android:text="Volver"
        android:layout_marginBottom="8dp"/>
</LinearLayout>
