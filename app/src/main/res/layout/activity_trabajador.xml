<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/etpaneltrabajador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PANEL DE TRABAJADOR"
        android:textSize="32dp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etnumerotarjeta"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:hint="Número de Tarjeta"
        android:inputType="text"
        android:layout_marginBottom="18dp"/>

    <EditText
        android:id="@+id/etnombre"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:hint="Nombre Completo"
        android:inputType="text"
        android:layout_marginBottom="18dp"/>

    <EditText
        android:id="@+id/etapellido"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:hint="Apellido Completo"
        android:inputType="text"
        android:layout_marginBottom="18dp"/>

    <EditText
        android:id="@+id/etcargo"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:hint="Cargo de Trabajador"
        android:inputType="text"
        android:layout_marginBottom="18dp"/>

    <EditText
        android:id="@+id/etfechaingreso"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:hint="Fecha y Hora de Ingreso"
        android:inputType="datetime"
        android:layout_marginBottom="18dp"/>

    <EditText
        android:id="@+id/etfechasalida"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:hint="Fecha  y Hora Salida"
        android:inputType="datetime"
        android:layout_marginBottom="18dp"/>

    <Button
        android:id="@+id/etguardar"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:text="Guardar"
        android:layout_marginBottom="18dp"/>

    <Button
        android:id="@+id/etvaciar"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:text="Vaciar Campos"
        android:layout_marginBottom="18dp"/>

    <Button
        android:id="@+id/etvolvertarjetas"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:text="Volver"
        android:layout_marginBottom="18dp"/>
</LinearLayout>